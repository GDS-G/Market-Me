# Core runtime (server-only)
NODE_ENV=development
DATABASE_URL=postgres://market_me:market_me_local@localhost:5432/market_me
APP_BASE_URL=http://localhost:3000

# Local development identity; disabled automatically in production.
MARKET_ME_DEV_LOGIN_ENABLED=true
MARKET_ME_DEV_USER_EMAIL=developer@market-me.local
MARKET_ME_DEV_USER_NAME=Market Me Developer

# Production identity (OpenID Connect Authorization Code + PKCE).
# HTTPS is required outside development. The callback is APP_BASE_URL/api/auth/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Organization account
# Exact verified emails allowed to create the first owner workspace. Comma-separated.
# Leave empty after initial provisioning; other users join through Team invitations.
OIDC_BOOTSTRAP_EMAILS=

# Generate with: openssl rand -base64 32
CONNECTOR_TOKEN_ENCRYPTION_KEY=
MASTODON_ALLOWED_HOSTS=
# Use a separate 32-byte key so connector-token and AI-provider credential rotation are isolated.
# Generate with: openssl rand -base64 32
AI_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_EXECUTION_ENABLED=false

# Operational incident alerts use a separate encryption key and an exact HTTPS host allowlist.
# Delivery remains unavailable until both are configured; comma-separate multiple hostnames.
# Generate with: openssl rand -base64 32
AI_OPERATIONAL_ALERT_ENCRYPTION_KEY=
AI_OPERATIONAL_ALERT_ALLOWED_HOSTS=
AI_OPERATIONAL_ALERT_BATCH_SIZE=25

# Google Drive OAuth web application
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Microsoft identity platform web application
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Public HTTPS origin used for Google Drive, Microsoft Graph, and managed signed Mailchimp callback creation.
# Leave empty locally to use the polling fallback.
PUBLIC_WEBHOOK_BASE_URL=

# Storage worker
CONNECTOR_POLL_INTERVAL_SECONDS=60
CONNECTOR_WORKER_RUN_ONCE=false
# Both background workers write instance-scoped leases at this cadence (5-60 seconds).
SERVICE_HEARTBEAT_INTERVAL_SECONDS=30
# Production web readiness requires an active lease no older than this (15-600 seconds).
SERVICE_HEARTBEAT_MAX_AGE_SECONDS=120
WEBHOOK_BATCH_SIZE=25
CONTENT_INGESTION_BATCH_SIZE=10
MAX_SOURCE_DOWNLOAD_BYTES=10485760
# Immutable media object storage. Filesystem is for local development only;
# production fails closed unless MEDIA_OBJECT_STORE=s3.
MEDIA_OBJECT_STORE=filesystem
MEDIA_STORAGE_ROOT=../../.market-me/media
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# Optional S3-compatible HTTPS endpoint. Leave empty for AWS S3.
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_S3_PREFIX=
# Leave credentials empty to use the AWS SDK's workload identity/credential chain.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
# Bounded reads: 1 KiB through 50 MiB.
MEDIA_OBJECT_MAX_READ_BYTES=52428800
MALWARE_SCANNER=unconfigured
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
MEDIA_PROCESSING_VERSION=image-v1

# Separate HMAC secret for five-minute media preview links. Generate at least 32 random bytes.
MEDIA_ACCESS_SIGNING_KEY=

# Durable campaign workflow worker
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_CAMPAIGN_TASK_QUEUE=market-me-campaigns
CAMPAIGN_COMMAND_BATCH_SIZE=25
CAMPAIGN_COMMAND_POLL_INTERVAL_MS=2000
# Automatic Mailchimp aggregate-report collection is opt-in and never requests recipient activity.
# The connector credential encryption key above is required when enabled.
MAILCHIMP_REPORT_COLLECTION_ENABLED=false
# Scan cadence: 5-60 seconds. Each pass claims at most 1-50 due reports.
MAILCHIMP_REPORT_COLLECTION_LOOP_MS=30000
MAILCHIMP_REPORT_COLLECTION_BATCH_SIZE=10
# Successful refresh: 5 minutes-24 hours. Collection retention: 1 hour-30 days.
MAILCHIMP_REPORT_COLLECTION_REFRESH_SECONDS=900
MAILCHIMP_REPORT_COLLECTION_MAX_AGE_SECONDS=604800
# Automatic Mastodon aggregate status-report collection is opt-in and never requests interacting accounts or content.
# CONNECTOR_TOKEN_ENCRYPTION_KEY and at least one exact MASTODON_ALLOWED_HOSTS entry are required when enabled.
MASTODON_STATUS_REPORT_COLLECTION_ENABLED=false
# Scan cadence: 5-60 seconds. Each pass claims at most 1-50 due reports.
MASTODON_STATUS_REPORT_COLLECTION_LOOP_MS=30000
MASTODON_STATUS_REPORT_COLLECTION_BATCH_SIZE=10
# Successful refresh: 5 minutes-24 hours. Collection retention: 1 hour-30 days.
MASTODON_STATUS_REPORT_COLLECTION_REFRESH_SECONDS=900
MASTODON_STATUS_REPORT_COLLECTION_MAX_AGE_SECONDS=604800
# Automatic managed-webhook inventory monitoring is opt-in and never mutates Mailchimp.
# The connector credential encryption key above is required when enabled.
MAILCHIMP_WEBHOOK_HEALTH_MONITOR_ENABLED=false
# Loop cadence: 5-60 seconds. Each pass claims at most 1-50 due connections.
MAILCHIMP_WEBHOOK_HEALTH_MONITOR_LOOP_MS=30000
MAILCHIMP_WEBHOOK_HEALTH_MONITOR_BATCH_SIZE=10
# Healthy/unhealthy provider inventory refresh: 5 minutes-24 hours.
MAILCHIMP_WEBHOOK_HEALTH_MONITOR_INTERVAL_SECONDS=3600

# Reserved for the Model Gateway release.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
